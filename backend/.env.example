# Copy to backend/.env and fill in your keys.

APP_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paste the pooled Neon connection string.
# postgresql://... is rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Web process in production: JOBS_SWEEP_DISABLE=1
# Worker process: leave unset.
JOBS_SWEEP_DISABLE=

# Stack Auth. Same project as my-app. Required in production.
STACK_PROJECT_ID=
STACK_SECRET_SERVER_KEY=
# STACK_API_URL=https://api.stack-auth.com
